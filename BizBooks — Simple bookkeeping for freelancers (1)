@charset "utf-8";

:root { --cream: #fffaf2; --peach: #ffe3cc; --coral: #ff8c69; --coral-dark: #e56f4c; --teal: #3fa89b; --teal-dark: #2f8a7f; --ink: #3a3331; --muted: #8a8077; --card: #ffffff; --border: #f0e4d8; --red: #e2574c; --green: #3fa89b; font-family: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--cream); color: var(--ink); }

a { color: var(--coral-dark); text-decoration: none; }

button { font-family: inherit; cursor: pointer; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; padding: 10px 18px; font-size: 15px; font-weight: 600; transition: transform 0.08s, box-shadow 0.08s; }

.btn:active { transform: scale(0.97); }

.btn-primary { background: var(--coral); color: rgb(255, 255, 255); box-shadow: 0 3px 0 var(--coral-dark); }

.btn-primary:hover { background: var(--coral-dark); }

.btn-secondary { background: var(--teal); color: rgb(255, 255, 255); box-shadow: 0 3px 0 var(--teal-dark); }

.btn-secondary:hover { background: var(--teal-dark); }

.btn-ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--border); }

.btn-ghost:hover { background: var(--peach); }

.btn-danger { background: rgb(253, 236, 235); color: var(--red); border: 1.5px solid rgb(246, 207, 203); }

input, select, textarea { font-family: inherit; font-size: 15px; padding: 9px 12px; border-radius: 8px; border: 1.5px solid var(--border); background: rgb(255, 253, 251); color: var(--ink); width: 100%; }

input:focus, select:focus, textarea:focus { outline: none; border-color: var(--coral); }

label { font-size: 13px; font-weight: 600; color: var(--muted); display: block; margin-bottom: 4px; }

.field { margin-bottom: 14px; }

.card { background: var(--card); border-radius: 16px; border: 1px solid var(--border); padding: 22px; box-shadow: rgba(180, 140, 100, 0.06) 0px 2px 10px; }

.app-shell { display: flex; min-height: 100vh; }

.sidebar { width: 220px; background: var(--card); border-right: 1px solid var(--border); padding: 24px 16px; display: flex; flex-direction: column; gap: 4px; }

.sidebar .logo { font-size: 20px; font-weight: 800; color: var(--coral-dark); margin-bottom: 18px; padding: 0px 8px; }

.sidebar a, .sidebar .nav-item { display: block; padding: 10px 12px; border-radius: 10px; color: var(--ink); font-weight: 600; font-size: 15px; }

.sidebar a.active { background: var(--peach); color: var(--coral-dark); }

.sidebar a:hover { background: var(--peach); }

.main { flex: 1 1 0%; padding: 32px 40px; max-width: 1100px; }

.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }

h1 { font-size: 26px; margin: 0px 0px 6px; }

h2 { font-size: 19px; margin: 0px 0px 12px; }

.subtitle { color: var(--muted); margin: 0px 0px 24px; font-size: 15px; }

.grid-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 28px; }

.stat-card { background: var(--card); border-radius: 14px; border: 1px solid var(--border); padding: 18px 20px; }

.stat-card .label { color: var(--muted); font-size: 13px; font-weight: 600; margin-bottom: 6px; }

.stat-card .value { font-size: 24px; font-weight: 800; }

.stat-card.income .value { color: var(--teal-dark); }

.stat-card.expense .value { color: var(--red); }

table { width: 100%; border-collapse: collapse; }

th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 14px; }

th { color: var(--muted); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; }

tr:last-child td { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; }

.badge.income { background: rgb(227, 244, 241); color: var(--teal-dark); }

.badge.expense { background: rgb(253, 236, 235); color: var(--red); }

.badge.paid { background: rgb(227, 244, 241); color: var(--teal-dark); }

.badge.unpaid { background: rgb(255, 243, 218); color: rgb(184, 134, 11); }

.auth-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg,var(--peach),var(--cream)); }

.auth-box { width: 380px; background: rgb(255, 255, 255); border-radius: 18px; padding: 36px; box-shadow: rgba(180, 120, 80, 0.15) 0px 10px 40px; }

.auth-box .logo { font-size: 26px; font-weight: 800; color: var(--coral-dark); text-align: center; margin-bottom: 4px; }

.auth-box .tag { text-align: center; color: var(--muted); margin-bottom: 24px; font-size: 14px; }

.error-msg { background: rgb(253, 236, 235); color: var(--red); border-radius: 8px; padding: 10px 14px; font-size: 14px; margin-bottom: 14px; }

.success-msg { background: rgb(227, 244, 241); color: var(--teal-dark); border-radius: 8px; padding: 10px 14px; font-size: 14px; margin-bottom: 14px; }

.switch-link { text-align: center; margin-top: 16px; font-size: 14px; color: var(--muted); }

.modal-overlay { position: fixed; inset: 0px; background: rgba(60, 40, 20, 0.35); display: flex; align-items: center; justify-content: center; z-index: 50; padding: 20px; }

.modal-box { background: rgb(255, 255, 255); border-radius: 16px; padding: 28px; width: 100%; max-width: 520px; max-height: 88vh; overflow-y: auto; }

.row-flex { display: flex; gap: 12px; }

.row-flex > * { flex: 1 1 0%; }

.empty-state { text-align: center; padding: 40px 20px; color: var(--muted); }

.toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; flex-wrap: wrap; gap: 10px; }

.pill-tabs { display: flex; gap: 8px; margin-bottom: 18px; }

.pill-tab { padding: 7px 16px; border-radius: 20px; border: 1.5px solid var(--border); background: rgb(255, 255, 255); font-weight: 600; font-size: 14px; color: var(--muted); }

.pill-tab.active { background: var(--coral); color: rgb(255, 255, 255); border-color: var(--coral); }

.doc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }

.doc-card { background: rgb(255, 255, 255); border: 1px solid var(--border); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 8px; }

.doc-card .doc-icon { font-size: 30px; }

.doc-card .doc-name { font-weight: 600; font-size: 13px; word-break: break-word; }

.doc-card .doc-meta { font-size: 12px; color: var(--muted); }

.banner { background: rgb(255, 243, 218); border: 1px solid rgb(243, 220, 160); border-radius: 10px; padding: 10px 16px; font-size: 14px; color: rgb(138, 106, 26); margin-bottom: 20px; }

.invoice-print { background: rgb(255, 255, 255); border-radius: 14px; padding: 30px; }

.invoice-print .inv-head { display: flex; justify-content: space-between; margin-bottom: 24px; }

.invoice-print table th, .invoice-print table td { font-size: 14px; }

.invoice-total { text-align: right; font-size: 20px; font-weight: 800; margin-top: 10px; }
